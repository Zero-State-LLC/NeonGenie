{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity Packet",
  "type": "object",
  "required": [
    "blocked_transition",
    "outcome_model",
    "system_topology",
    "opportunity_thesis",
    "validation_path",
    "completion_proof",
    "scorecard",
    "promotion_state",
    "logic_label"
  ],
  "properties": {
    "blocked_transition": {},
    "outcome_model": {},
    "system_topology": {},
    "opportunity_thesis": {},
    "validation_path": {},
    "completion_proof": {
      "description": "Externally checkable success criterion (what proves the transition is done)"
    },
    "scorecard": {},
    "promotion_state": {},
    "proof_path": {
      "description": "Ordered steps to obtain completion_proof"
    },
    "logic_label": {
      "type": "string",
      "enum": [
        "effectual",
        "causal",
        "mixed"
      ],
      "description": "Dual-logic label (U1). Required as of 3.27.0. Gate LOGIC."
    },
    "evidence_ledger": {
      "description": "Optional attach when evidence_intelligence co-resolves. See schemas/evidence-ledger.schema.json. Gate LEDGER.",
      "type": "object",
      "required": [
        "claims",
        "relations"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "neon-genie/evidence-ledger"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "claims": {
          "type": "array",
          "description": "Claim nodes. Every material promoting claim needs an active cite into this set.",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "text",
              "label"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "enum": [
                  "OBSERVED",
                  "INFERRED",
                  "SPECULATIVE",
                  "NOT_COMPUTABLE"
                ]
              },
              "active": {
                "type": "boolean",
                "description": "False = retired/superseded; inactive cites do not satisfy Gate LEDGER"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "relations": {
          "type": "array",
          "description": "Typed edges between claims and/or evidence items",
          "items": {
            "type": "object",
            "required": [
              "relation_id",
              "from_id",
              "to_id",
              "relation"
            ],
            "properties": {
              "relation_id": {
                "type": "string",
                "minLength": 1
              },
              "from_id": {
                "type": "string",
                "minLength": 1
              },
              "to_id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "enum": [
                  "Support",
                  "Depend-on",
                  "Contradict",
                  "Invalidate",
                  "Update"
                ]
              },
              "resolved": {
                "type": "boolean",
                "description": "Required true (or Update edge) before \u2265TESTABLE when relation is Contradict/Invalidate"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
