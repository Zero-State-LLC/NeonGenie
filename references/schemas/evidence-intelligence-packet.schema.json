{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Intelligence Packet",
  "type": "object",
  "required": [
    "decision_questions",
    "query_plan",
    "evidence_items",
    "claim_ledger",
    "tooling_gaps",
    "attribution_boundaries",
    "research_log",
    "not_computable_fields",
    "evidence_ledger"
  ],
  "properties": {
    "decision_questions": {},
    "query_plan": {},
    "evidence_items": {},
    "claim_ledger": {},
    "tooling_gaps": {},
    "attribution_boundaries": {},
    "research_log": {},
    "not_computable_fields": {},
    "competitive_scan": {},
    "grant_or_funder_map": {},
    "board_or_stakeholder_map": {},
    "freshness_notes": {},
    "evidence_ledger": {
      "description": "Required as of 3.27.0 when EvidenceIntelligence packet is emitted. Typed EviGraph claim graph; see evidence-ledger.schema.json. Gate LEDGER.",
      "type": "object",
      "required": [
        "claims",
        "relations"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "neon-genie/evidence-ledger"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "claims": {
          "type": "array",
          "description": "Claim nodes. Every material promoting claim needs an active cite into this set.",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "text",
              "label"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "enum": [
                  "OBSERVED",
                  "INFERRED",
                  "SPECULATIVE",
                  "NOT_COMPUTABLE"
                ]
              },
              "active": {
                "type": "boolean",
                "description": "False = retired/superseded; inactive cites do not satisfy Gate LEDGER"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "relations": {
          "type": "array",
          "description": "Typed edges between claims and/or evidence items",
          "items": {
            "type": "object",
            "required": [
              "relation_id",
              "from_id",
              "to_id",
              "relation"
            ],
            "properties": {
              "relation_id": {
                "type": "string",
                "minLength": 1
              },
              "from_id": {
                "type": "string",
                "minLength": 1
              },
              "to_id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "enum": [
                  "Support",
                  "Depend-on",
                  "Contradict",
                  "Invalidate",
                  "Update"
                ]
              },
              "resolved": {
                "type": "boolean",
                "description": "Required true (or Update edge) before \u2265TESTABLE when relation is Contradict/Invalidate"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "research_search_dag": {
      "description": "Optional in 3.26.x (warn-then-require). Write only when research runs. Canonical: schemas/research-search-dag.schema.json. Gate PILOT.",
      "type": "object",
      "required": [
        "stages",
        "research_ran"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "neon-genie/research-search-dag"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "research_ran": {
          "type": "boolean",
          "description": "True only when host research/fetch actually ran this run"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered DAG stages",
          "items": {
            "type": "object",
            "required": [
              "stage_id",
              "kind"
            ],
            "properties": {
              "stage_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "keyword",
                  "cite-expand",
                  "filter",
                  "score",
                  "extract"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "verified_fetch": {
                      "type": "boolean"
                    },
                    "operator_supplied": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from_stage",
              "to_stage"
            ],
            "properties": {
              "from_stage": {
                "type": "string"
              },
              "to_stage": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
