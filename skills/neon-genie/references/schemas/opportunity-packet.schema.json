{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neon-genie/opportunity-packet/1.3.0",
  "title": "Opportunity Packet",
  "description": "Hermes-native opportunity packet. 1.2.0 adds optional bake-off fields (research record, input_contradictions, structured kill_criteria, build_handoff.first_commit, page_budget). 1.3.0 adds an optional kill derivation that packaging recomputes when schema_version >= 1.3.0. Packaging requires the 1.2.0 fields only when schema_version >= 1.2.0. Older packets stay valid. Do not invent buyers or OBSERVED proof. Gate C: economic_buyer is separate from beneficiary.",
  "type": "object",
  "required": [
    "blocked_transition",
    "outcome_model",
    "system_topology",
    "opportunity_thesis",
    "validation_path",
    "completion_proof",
    "scorecard",
    "promotion_state",
    "logic_label"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "neon-genie/opportunity-packet"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "blocked_transition": {
      "type": "object",
      "description": "Current state the user cannot complete → desired state",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "outcome_model": {
      "type": "object",
      "description": "Success/failure outcomes and how they are checked",
      "additionalProperties": true
    },
    "system_topology": {
      "type": "object",
      "description": "Actors, systems, and coordination surfaces",
      "additionalProperties": true
    },
    "opportunity_thesis": {
      "type": "string",
      "minLength": 1,
      "description": "Why this transition is worth testing. Label claims in prose; do not invent OBSERVED demand."
    },
    "validation_path": {
      "type": "array",
      "description": "Ordered checks toward completion_proof",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "completion_proof": {
      "type": [
        "string",
        "object"
      ],
      "description": "Externally checkable success criterion (what proves the transition is done)"
    },
    "scorecard": {
      "type": "object",
      "description": "Evidence/outcome scores. Cannot override a failed mandatory gate.",
      "additionalProperties": true
    },
    "promotion_state": {
      "type": "string",
      "minLength": 1,
      "description": "Promotion ladder state. Scorecard cannot raise this past a failed gate."
    },
    "proof_path": {
      "type": "array",
      "description": "Ordered steps to obtain completion_proof",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "logic_label": {
      "type": "string",
      "enum": [
        "effectual",
        "causal",
        "mixed"
      ],
      "description": "Dual-logic label (U1). Required as of 3.27.0. Gate LOGIC."
    },
    "affected_user": {
      "type": "string",
      "minLength": 1,
      "description": "Concrete person or role who cannot complete the transition. Profile-required; schema-optional to stay additive."
    },
    "economic_buyer": {
      "type": "string",
      "minLength": 1,
      "description": "Who pays or authorizes spend. Gate C: must stay separate from beneficiary/affected_user unless evidenced as the same party."
    },
    "transition_market": {
      "type": "string",
      "description": "Current → desired state gap the wedge addresses"
    },
    "coordination_gap": {
      "type": "string",
      "description": "Why the transition has not already cleared"
    },
    "service_first_wedge": {
      "type": "string",
      "description": "Smallest testable intervention (service-first, not platform-first)"
    },
    "distribution": {
      "type": [
        "string",
        "object"
      ],
      "description": "How the wedge reaches the affected user"
    },
    "failure_modes": {
      "type": [
        "string",
        "array"
      ],
      "description": "How the opportunity dies"
    },
    "jtbd": {
      "type": "string",
      "description": "Optional job-to-be-done restatement. Hermes-native alias of profile language; not a PRISM-only name."
    },
    "research": {
      "type": "object",
      "description": "Evidence-gathering record. OBSERVED claims need a URL and retrieval date. Offline records must not contain OBSERVED claims.",
      "properties": {
        "enabled": {"type": "boolean"},
        "offline": {"type": "boolean"},
        "adapter": {"type": "string"},
        "research_ran": {"type": "boolean"},
        "observed_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "label"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "label": {
                "type": "string",
                "enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]
              },
              "url": {"type": "string"},
              "retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "kind": {
                "type": "string",
                "enum": ["web_page", "paper", "social_post"]
              },
              "text": {"type": "string"},
              "text_in": {"type": "string"}
            }
          }
        },
        "rejected": {"type": "array"},
        "items": {"type": "array"}
      }
    },
    "input_contradictions": {
      "type": "object",
      "description": "Mandatory pass over input notes before the packet is written. Empty findings are valid.",
      "required": ["checked", "findings"],
      "properties": {
        "checked": {"type": "boolean", "const": true},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "kind", "summary", "claim_label"],
            "properties": {
              "finding_id": {"type": "string", "minLength": 1},
              "kind": {
                "type": "string",
                "enum": ["contradiction", "arithmetic_error", "inconsistent_figure"]
              },
              "summary": {"type": "string", "minLength": 1},
              "claim_label": {
                "type": "string",
                "enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]
              },
              "evidence": {"type": "string"}
            }
          }
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "description": "Structured kills. Prose-only values fail. Each item needs metric, numeric threshold, comparison, check_date, and data_source.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "threshold", "comparison", "check_date", "data_source", "claim_label"],
        "properties": {
          "criterion_id": {"type": "string"},
          "metric": {"type": "string", "minLength": 1},
          "threshold": {"type": "number"},
          "comparison": {
            "type": "string",
            "enum": ["lt", "lte", "gt", "gte", "eq", "neq"]
          },
          "check_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "data_source": {"type": "string", "minLength": 1},
          "claim_label": {
            "type": "string",
            "enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "role": {"type": "string"},
          "quote": {"type": "string"},
          "derivation": {
            "type": "object",
            "description": "Inputs used to recompute threshold. Required by packaging when schema_version >= 1.3.0. Not required by this schema, so 1.2.0 packets still validate.",
            "required": ["formula", "inputs", "depends_on"],
            "properties": {
              "formula": {
                "type": "string",
                "enum": ["identity", "sum", "min", "product", "net_of_percent_and_fixed", "min_tier_net_of_fee"]
              },
              "inputs": {"type": "object"},
              "depends_on": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "tier_count": {"type": "integer"},
              "justification": {
                "type": "string",
                "description": "Optional. Required by packaging when formula is identity and the packet states tiers or fees this derivation does not use."
              }
            }
          }
        }
      }
    },
    "build_handoff": {
      "type": "object",
      "description": "Build handoff. first_commit is the concrete first move.",
      "required": ["first_commit"],
      "properties": {
        "summary": {"type": "string"},
        "steps": {"type": "array", "items": {"type": "string"}},
        "first_commit": {
          "type": "object",
          "required": ["touch", "done_when", "test_to_write", "owner_role"],
          "properties": {
            "touch": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "done_when": {"type": "string", "minLength": 1},
            "test_to_write": {"type": "string", "minLength": 1},
            "owner_role": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "page_budget": {
      "type": "object",
      "description": "Decision prose cap: 450 words and 3200 characters. Evidence lives in appendix. truncated must stay false.",
      "required": ["word_budget", "char_budget", "main_word_count", "main_char_count", "fits_one_page", "truncated"],
      "properties": {
        "word_budget": {"type": "integer"},
        "char_budget": {"type": "integer"},
        "main_word_count": {"type": "integer"},
        "main_char_count": {"type": "integer"},
        "appendix_word_count": {"type": "integer"},
        "fits_one_page": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    },
    "appendix": {
      "type": "object",
      "description": "Full evidence moved off the one-page decision prose. Bodies are not sliced.",
      "properties": {
        "research_claims": {"type": "array"},
        "contradiction_evidence": {"type": "array"}
      }
    },
    "evidence_ledger": {
      "description": "Optional attach when evidence_intelligence co-resolves. See schemas/evidence-ledger.schema.json. Gate LEDGER.",
      "type": "object",
      "required": [
        "claims",
        "relations"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "neon-genie/evidence-ledger"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "claims": {
          "type": "array",
          "description": "Claim nodes. Every material promoting claim needs an active cite into this set.",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "text",
              "label"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "enum": [
                  "OBSERVED",
                  "INFERRED",
                  "SPECULATIVE",
                  "NOT_COMPUTABLE"
                ]
              },
              "active": {
                "type": "boolean",
                "description": "False = retired/superseded; inactive cites do not satisfy Gate LEDGER"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "relations": {
          "type": "array",
          "description": "Typed edges between claims and/or evidence items",
          "items": {
            "type": "object",
            "required": [
              "relation_id",
              "from_id",
              "to_id",
              "relation"
            ],
            "properties": {
              "relation_id": {
                "type": "string",
                "minLength": 1
              },
              "from_id": {
                "type": "string",
                "minLength": 1
              },
              "to_id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "enum": [
                  "Support",
                  "Depend-on",
                  "Contradict",
                  "Invalidate",
                  "Update"
                ]
              },
              "resolved": {
                "type": "boolean",
                "description": "Required true (or Update edge) before ≥TESTABLE when relation is Contradict/Invalidate"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
