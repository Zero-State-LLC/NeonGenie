{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neon-genie/commercial-simulation/1.2.0",
  "title": "Commercial Simulation",
  "description": "Hermes-native commercial simulation. 1.2.0 adds the same optional bake-off fields as the opportunity packet (research record, input_contradictions, structured kill_criteria, build_handoff.first_commit, page_budget). Packaging requires them only when schema_version >= 1.2.0. 1.1.0 packets stay valid. Do not invent buyers, CAC, LTV, or revenue as OBSERVED. Gate B / NG-COMM-001: unit-econ OBSERVED needs evidence_refs. engine_tag stays PRISM-sidecar-only.",
  "type": "object",
  "required": [
    "buyer_map",
    "pricing_model",
    "cost_scenarios",
    "revenue_scenarios",
    "distribution",
    "risks"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "neon-genie/commercial-simulation"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "buyer_map": {
      "type": "object",
      "description": "Gate C: separate economic_buyer from beneficiary. Additional role keys (user, payer, authorizer, risk_bearer) remain allowed.",
      "properties": {
        "economic_buyer": {
          "type": "string",
          "minLength": 1,
          "description": "Who pays or authorizes. Use NOT_COMPUTABLE_until_declared when unknown; never invent a named buyer."
        },
        "beneficiary": {
          "type": "string",
          "minLength": 1,
          "description": "Who receives the value. Must not be silently collapsed into economic_buyer."
        },
        "evidence_refs": {
          "type": "array",
          "description": "Workspace or operator cites that separate roles. Empty when roles are still NOT_COMPUTABLE.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "pricing_model": {
      "type": "object",
      "description": "Packaging shape and assumptions. Assumptions are SPECULATIVE unless evidence_refs support a stronger label. CAC/LTV labeled OBSERVED without evidence_refs fail packaging (NG-COMM-001).",
      "properties": {
        "model_type": {
          "type": "string",
          "enum": [
            "fixed_fee",
            "subscription",
            "usage",
            "hybrid",
            "donation",
            "not_computable"
          ],
          "description": "Optional typed packaging class. Recipes may still use free-text shape until a type is known."
        },
        "assumptions": {
          "type": "string",
          "description": "Model assumptions. Label SPECULATIVE unless evidenced."
        },
        "claim_label": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "INFERRED",
            "SPECULATIVE",
            "NOT_COMPUTABLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cac": {
          "description": "Customer acquisition cost. OBSERVED only with evidence_refs."
        },
        "ltv": {
          "description": "Lifetime value. OBSERVED only with evidence_refs."
        }
      },
      "additionalProperties": true
    },
    "cost_scenarios": {
      "type": [
        "object",
        "array"
      ],
      "description": "Cost ranges with provenance. Object form (conservative/balanced/aggressive) remains valid; prefer scenarios[] when emitting labeled rows."
    },
    "revenue_scenarios": {
      "type": [
        "object",
        "array"
      ],
      "description": "Revenue ranges with provenance. Never invent firm revenue as OBSERVED."
    },
    "scenarios": {
      "type": "array",
      "description": "Optional labeled scenario rows (cost, revenue, or mixed). Each row needs a claim_label.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "claim_label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "claim_label": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "INFERRED",
              "SPECULATIVE",
              "NOT_COMPUTABLE"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "cost",
              "revenue",
              "mixed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "distribution": {
      "type": [
        "object",
        "string"
      ],
      "description": "How the offer reaches a buyer. Object form used by recipes; string form allowed."
    },
    "risks": {
      "type": "array",
      "description": "Commercial failure modes, including buyer/beneficiary conflation and fabricated market size",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "research": {
      "type": "object",
      "description": "Evidence-gathering record. OBSERVED claims need a URL and retrieval date. Offline records must not contain OBSERVED claims.",
      "properties": {
        "enabled": {"type": "boolean"},
        "offline": {"type": "boolean"},
        "adapter": {"type": "string"},
        "research_ran": {"type": "boolean"},
        "observed_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "label"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "label": {
                "type": "string",
                "enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]
              },
              "url": {"type": "string"},
              "retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "kind": {
                "type": "string",
                "enum": ["web_page", "paper", "social_post"]
              },
              "text": {"type": "string"},
              "text_in": {"type": "string"}
            }
          }
        },
        "rejected": {"type": "array"},
        "items": {"type": "array"}
      }
    },
    "input_contradictions": {
      "type": "object",
      "description": "Mandatory pass over input notes before the packet is written. Empty findings are valid.",
      "required": ["checked", "findings"],
      "properties": {
        "checked": {"type": "boolean", "const": true},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "kind", "summary", "claim_label"],
            "properties": {
              "finding_id": {"type": "string", "minLength": 1},
              "kind": {
                "type": "string",
                "enum": ["contradiction", "arithmetic_error", "inconsistent_figure"]
              },
              "summary": {"type": "string", "minLength": 1},
              "claim_label": {
                "type": "string",
                "enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]
              },
              "evidence": {"type": "string"}
            }
          }
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "description": "Structured kills. Prose-only values fail. Each item needs metric, numeric threshold, comparison, check_date, and data_source.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "threshold", "comparison", "check_date", "data_source", "claim_label"],
        "properties": {
          "criterion_id": {"type": "string"},
          "metric": {"type": "string", "minLength": 1},
          "threshold": {"type": "number"},
          "comparison": {
            "type": "string",
            "enum": ["lt", "lte", "gt", "gte", "eq", "neq"]
          },
          "check_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "data_source": {"type": "string", "minLength": 1},
          "claim_label": {
            "type": "string",
            "enum": ["OBSERVED", "INFERRED", "SPECULATIVE", "NOT_COMPUTABLE"]
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "role": {"type": "string"}
        }
      }
    },
    "build_handoff": {
      "type": "object",
      "description": "Build handoff. first_commit is the concrete first move.",
      "required": ["first_commit"],
      "properties": {
        "summary": {"type": "string"},
        "steps": {"type": "array", "items": {"type": "string"}},
        "first_commit": {
          "type": "object",
          "required": ["touch", "done_when", "test_to_write", "owner_role"],
          "properties": {
            "touch": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "done_when": {"type": "string", "minLength": 1},
            "test_to_write": {"type": "string", "minLength": 1},
            "owner_role": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "page_budget": {
      "type": "object",
      "description": "Decision prose cap: 450 words and 3200 characters. Evidence lives in appendix. truncated must stay false.",
      "required": ["word_budget", "char_budget", "main_word_count", "main_char_count", "fits_one_page", "truncated"],
      "properties": {
        "word_budget": {"type": "integer"},
        "char_budget": {"type": "integer"},
        "main_word_count": {"type": "integer"},
        "main_char_count": {"type": "integer"},
        "appendix_word_count": {"type": "integer"},
        "fits_one_page": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    },
    "appendix": {
      "type": "object",
      "description": "Full evidence moved off the one-page decision prose. Bodies are not sliced.",
      "properties": {
        "research_claims": {"type": "array"},
        "contradiction_evidence": {"type": "array"}
      }
    }
  },
  "additionalProperties": true
}
